# Copy this file to .env and adjust the values. .env is never committed.

# Host port where docker-compose.yml publishes PostgreSQL. Change it if 5432 is taken by another project.
DB_PORT=5432

# PostgreSQL connection used by the API and the TypeORM CLI. The port must match DB_PORT.
DATABASE_URL=postgres://kairo:kairo@localhost:5432/kairo
# Database for end-to-end tests. Its name must end in _test; the test setup refuses anything else.
TEST_DATABASE_URL=postgres://kairo:kairo@localhost:5432/kairo_test

# API
NODE_ENV=development
PORT=4000
